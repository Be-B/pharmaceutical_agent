# OpenAI API 키 — 임베딩(indexer) 및 LLM(backend) 호출에 사용
OPENAI_API_KEY=sk-...

# Cohere API 키 — reranker 호출에 사용 (없으면 FAISS top-5로 자동 fallback)
COHERE_API_KEY=...

# Cohere rerank 모델 — rerank-v4.0-pro 등으로 변경 가능
COHERE_RERANK_MODEL=rerank-v3.5

# OpenAI 임베딩 모델 (3072차원) — 변경 시 인덱스 재빌드 필요
EMBEDDING_MODEL=text-embedding-3-large

# 기본 LLM 모델 — prompt_versions.model이 비어있을 때만 사용 (gpt-4o 등으로 교체 가능)
DEFAULT_LLM_MODEL=gpt-4o-mini

# JWT 서명 비밀키 — openssl rand -hex 32 로 생성 후 교체 필수
JWT_SECRET=change-me-please-use-openssl-rand-hex-32

# JWT 서명 알고리즘
JWT_ALGORITHM=HS256

# HTTP 환경(로컬)에선 false, HTTPS 프로덕션에선 true
COOKIE_SECURE=false

# 부트스트랩 admin 계정 이메일 (= 로그인 ID).
# 서버는 매 startup마다 이 계정의 비번/role을 .env 값으로 force-sync 합니다.
BOOTSTRAP_ADMIN_EMAIL=admin

# 부트스트랩 admin 계정 비밀번호 — 프로덕션에선 반드시 변경할 것
BOOTSTRAP_ADMIN_PASSWORD=adminpass

# CORS 허용 오리진 — 브라우저에서 backend API를 호출할 주소
CORS_ALLOW_ORIGINS=http://localhost:3000
